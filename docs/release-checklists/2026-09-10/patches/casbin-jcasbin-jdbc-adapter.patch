@@ -77,21 +89,27 @@ jobs:
           gpg-private-key: ${{ secrets.GPG_PRIVATE_KEY }}
           gpg-passphrase: MAVEN_GPG_PASSPHRASE
 
-      - name: Stamp the release version into the POM
-        run: mvn -B versions:set -DnewVersion=${{ steps.version.outputs.version }} -DgenerateBackupPoms=false
+      - name: Verify the committed POM version
+        env:
+          VERSION: ${{ steps.version.outputs.version }}
+        run: |
+          python3 - <<'PY'
+          import os
+          import xml.etree.ElementTree as ET
+          version = ET.parse('pom.xml').getroot().findtext('{http://maven.apache.org/POM/4.0.0}version')
+          if version != os.environ['VERSION']:
+              raise SystemExit(f"POM version {version} does not match tag version {os.environ['VERSION']}; commit the version change before tagging.")
+          PY
 
       - name: Build the source package
         env:
           SRC_NAME: ${{ steps.version.outputs.src_name }}
         run: |
           set -euo pipefail
-          # The file list comes from git, so the package holds exactly the
-          # tracked sources of the tag - no build output, no VCS metadata.
-          # The contents are read from the working tree, so the POM already
-          # carries the release version and the package builds as-is.
-          git ls-files -z | tar --null -T - \
-            --transform "s,^,$SRC_NAME/," \
-            -czf "$SRC_NAME.tar.gz"
+          # Archive the reviewed commit without rewriting its POM or reading
+          # generated/uncommitted working-tree contents.
+          git archive --format=tar.gz --prefix="$SRC_NAME/" \
+            -o "$SRC_NAME.tar.gz" HEAD
           ls -l "$SRC_NAME.tar.gz"
           tar -tzf "$SRC_NAME.tar.gz"
 
